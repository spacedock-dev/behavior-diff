#!/usr/bin/env bash
# Diff agent behavior for a rule that lives in a markdown file.
#
#   behavior-diff RULE.md --task "..." [--into FILE] [--fast | --trials N]
#                                      [--agent claude|codex|pi|omp] [--model NAME]
#                                      [--dry-run]
#
# The underlying runner compares the repo at HEAD against the repo plus one
# uncommitted instruction-file edit. This front door makes that edit for you:
# it appends RULE.md to the repo's instruction file, runs the diff, and puts
# the file back exactly as it was — so a rule you are still deciding about
# never has to be pasted in by hand.
#
# The target is the repo-root CLAUDE.md or AGENTS.md. With both present it
# asks (or, with no terminal, tells you to pass --into).
#
# It refuses to touch a target that already has uncommitted changes: mixing
# your edit with the rule would make the diff untraceable to either one.
set -euo pipefail

here=$(cd -- "$(dirname -- "$0")" && pwd -P)
runner=$here/../plugin/skills/behavior-diff/scripts/behavior-diff.sh

die() {
  printf 'behavior-diff: %s\n' "$1" >&2
  exit 2
}

usage() {
  sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

rule='' task='' into='' dry='' passthru=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --task)
      [[ $# -ge 2 ]] || die "--task needs a value"
      task=$2
      shift 2
      ;;
    --into)
      [[ $# -ge 2 ]] || die "--into needs a value"
      into=$2
      shift 2
      ;;
    --dry-run)
      dry=1
      shift
      ;;
    --fast)
      passthru+=("$1")
      shift
      ;;
    --trials | --agent | --model | --extract-agent | --extract-model)
      [[ $# -ge 2 ]] || die "$1 needs a value"
      passthru+=("$1" "$2")
      shift 2
      ;;
    -h | --help) usage ;;
    -*) die "unknown option $1" ;;
    *)
      [[ -z $rule ]] || die "only one rule file (got $rule and $1)"
      rule=$1
      shift
      ;;
  esac
done

[[ -n $rule ]] || usage
[[ -f $rule ]] || die "no such rule file: $rule"
[[ -n $task || -n $dry ]] || die "--task is required (the scenario the agents get)"
[[ -x $runner ]] || die "runner not found or not executable: $runner"

repo=$(git rev-parse --show-toplevel 2>/dev/null) ||
  die "run this from inside the git repo you want to test"

# Pick the instruction file the rule lands in.
if [[ -n $into ]]; then
  target=$into
else
  candidates=()
  for name in CLAUDE.md AGENTS.md; do
    [[ -f $repo/$name ]] && candidates+=("$name")
  done
  case ${#candidates[@]} in
    0) die "no CLAUDE.md or AGENTS.md at the repo root — pass --into FILE" ;;
    1) target=${candidates[0]} ;;
    *)
      if [[ -t 0 ]]; then
        printf 'Which file should the rule go in?\n' >&2
        select choice in "${candidates[@]}"; do
          [[ -n ${choice:-} ]] && {
            target=$choice
            break
          }
        done
      else
        die "both CLAUDE.md and AGENTS.md exist — pass --into FILE"
      fi
      ;;
  esac
fi

[[ -f $repo/$target ]] || die "target does not exist: $target"
git -C "$repo" cat-file -e "HEAD:$target" 2>/dev/null ||
  die "$target is not committed at HEAD — the runner needs a committed baseline"
git -C "$repo" diff --quiet HEAD -- "$target" ||
  die "$target already has uncommitted changes — commit or stash them first, so the diff measures only the rule"

# Restore the target no matter how this exits, and prove the restore is exact.
backup=$(mktemp -t behavior-diff-target)
cp -- "$repo/$target" "$backup"
restore() {
  local code=$?
  if [[ -f $backup ]]; then
    cp -- "$backup" "$repo/$target"
    if cmp -s -- "$backup" "$repo/$target"; then
      printf 'restored %s\n' "$target"
    else
      printf 'behavior-diff: RESTORE FAILED — your original is at %s\n' \
        "$backup" >&2
      exit 1
    fi
    rm -f -- "$backup"
  fi
  exit $code
}
trap restore EXIT INT TERM

printf 'applying %s to %s\n' "$rule" "$target"
{
  printf '\n'
  cat -- "$rule"
} >>"$repo/$target"

if [[ -n $dry ]]; then
  printf '\n--- the edit this would test ---\n'
  git -C "$repo" diff -- "$target"
  printf -- '--- dry run: no trials started ---\n'
  exit 0
fi

(cd "$repo" && "$runner" --file "$target" --task "$task" "${passthru[@]+"${passthru[@]}"}")
